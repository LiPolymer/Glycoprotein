<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>Glycoprotein.Dn8</Title>
        <Authors>LiPolymer</Authors>
        <Description>(dotnet8 compatiable) a strange IPC lib for service exposure</Description>
        <PackageIcon>icon.png</PackageIcon>
        <Copyright>LiPolymer</Copyright>
        <PackageProjectUrl>https://github.com/LiPolymer/Glycoprotein</PackageProjectUrl>
        <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/LiPolymer/Glycoprotein</RepositoryUrl>
        <PackageId>Glycoprotein.Dn8</PackageId>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="JsonSchema.Net" Version="9.2.2" />
      <PackageReference Include="JsonSchema.Net.Generation" Version="7.3.10" />
    </ItemGroup>

    <ItemGroup>
      <None Update="icon.png">
        <Pack>True</Pack>
        <PackagePath/>
      </None>
    </ItemGroup>

</Project>
